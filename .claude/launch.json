{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cayman-mortgage",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["server.py", "--no-open"],
      "port": 8787
    },
    {
      "name": "cayman-site",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "http.server", "8788", "--directory", "site"],
      "port": 8788
    }
  ]
}
